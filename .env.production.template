# ==============================================================================
# MetroScope — Production Environment Configuration Template
# Target: AWS EC2 t3.small (Sydney ap-southeast-2), Ubuntu 24.04 LTS, Docker Compose
# Deployment Root: /srv/metroscope/app
# ==============================================================================

# --- Application Runtime Environment ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
PROJECT_NAME=MetroScope
API_V1_STR=/api/v1

# --- Security & Networking ---
SITE_URL=https://themetroscope.com
NEXT_PUBLIC_SITE_URL=https://themetroscope.com
NEXT_PUBLIC_API_URL=https://themetroscope.com/api/v1
NEXT_PUBLIC_APP_NAME=MetroScope
PORT=3000

# Trusted Hosts & CORS (Restrict strictly to production domains and internal service names)
ALLOWED_HOSTS=["themetroscope.com","www.themetroscope.com","api.themetroscope.com","backend","localhost","127.0.0.1"]
BACKEND_CORS_ORIGINS=["https://themetroscope.com","https://www.themetroscope.com","https://api.themetroscope.com"]

# --- Security Keys & Cryptography ---
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_MIN_32_CHARACTERS_HIGH_ENTROPY_HEX
# Generate with: openssl rand -hex 32 (Required: minimum 32 chars in production)
OPERATOR_API_KEY=CHANGE_ME_MIN_32_CHARACTERS_HIGH_ENTROPY_HEX

# --- Database Settings (PostgreSQL 16 Alpine on internal Docker network) ---
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=metroscope
POSTGRES_USER=metroscope_user
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_GENERATED_PASSWORD_MIN_32_CHARS
DATABASE_URL=postgresql+asyncpg://metroscope_user:CHANGE_ME_TO_STRONG_GENERATED_PASSWORD_MIN_32_CHARS@db:5432/metroscope
DATABASE_SYNC_URL=postgresql://metroscope_user:CHANGE_ME_TO_STRONG_GENERATED_PASSWORD_MIN_32_CHARS@db:5432/metroscope

# Persistent Storage Path on Host
POSTGRES_DATA_DIR=/srv/metroscope/data/postgres

# --- Server Binding ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Worker & Webz.io News Ingestion Pipeline ---
# SAFETY CRITICAL: Collection and worker are disabled by default for initial deployment
WORKER_ENABLED=false
WEBZ_IO_COLLECTION_ENABLED=false

WEBZ_IO_API_KEY=your_webz_io_production_api_token
WEBZ_IO_BASE_URL=https://api.webz.io
WEBZ_IO_ENDPOINT=/newsApiLite
WEBZ_IO_MONTHLY_CREDIT=5.00
WEBZ_IO_COLLECTION_CEILING=4.00
WEBZ_IO_PROTECTED_RESERVE=1.00
WEBZ_IO_ESTIMATED_COST_PER_REQUEST=0.0050
WEBZ_IO_REQUEST_TIMEOUT_SECONDS=15.0
WEBZ_IO_MAX_RETRIES=1
WEBZ_IO_TIMEZONE=Asia/Dhaka
WEBZ_IO_MORNING_SCHEDULE_HOUR=8
WEBZ_IO_MORNING_SCHEDULE_MINUTE=0
WEBZ_IO_EVENING_SCHEDULE_HOUR=20
WEBZ_IO_EVENING_SCHEDULE_MINUTE=0
WEBZ_IO_TARGET_ARTICLES_PER_JOB=10
INGESTION_MIN_QUALITY_SCORE=30.0

# --- Automated Social Publishing (Meta Graph & X API v2) ---
# SAFETY CRITICAL: All publishing disabled and in dry-run mode
SOCIAL_PUBLISHING_ENABLED=false
SOCIAL_DRY_RUN=true
SOCIAL_PUBLISHING_INTERVAL_MINUTES=30
SOCIAL_MAX_POSTS_PER_RUN=2
SOCIAL_MIN_QUALITY_SCORE=70.0
STALE_PUBLISHING_TIMEOUT_MINUTES=60

# Facebook Page (Meta Graph API)
FACEBOOK_ENABLED=false
FACEBOOK_AUTO_PUBLISH=false
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v27.0
FACEBOOK_MAX_POSTS_PER_DAY=48

# X (Twitter API v2)
X_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
X_MAX_POSTS_PER_DAY=15

# --- Email Subscription & Newsletter Delivery ---
# SAFETY CRITICAL: EMAIL_DRY_RUN must remain true until SMTP credentials are confirmed
EMAIL_DRY_RUN=true
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=
SMTP_FROM_EMAIL=newsletter@themetroscope.com
SMTP_FROM_NAME=MetroScope News
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15.0
NEWSLETTER_SCHEDULE_HOUR=6
NEWSLETTER_SCHEDULE_MINUTE=0
NEWSLETTER_MIN_QUALITY_SCORE=70.0
NEWSLETTER_MAX_ARTICLES=5
SUBSCRIPTION_RATE_LIMIT_PER_HOUR=5
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# --- ScreenshotOne Dual-Key Photo Card Rendering ---
SCREENSHOTONE_ACCESS_KEY_1=
SCREENSHOTONE_ACCESS_KEY_2=
SCREENSHOTONE_SECRET_KEY=

# --- Container Registry & Deployment (GitHub Container Registry) ---
IMAGE_TAG=latest
GHCR_REGISTRY=ghcr.io
GHCR_OWNER=mahamudh-official
GHCR_REPO=metroscope
