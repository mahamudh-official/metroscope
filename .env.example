# ==============================================================================
# MetroScope - Environment Configuration Template
# Copy this file to .env and adjust variables as appropriate for your environment.
# ==============================================================================

# --- Application Environment ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=metroscope
POSTGRES_USER=metroscope_user
POSTGRES_PASSWORD=metroscope_secure_password
# Full database URL (optional override, otherwise constructed from parts above)
DATABASE_URL=postgresql+asyncpg://metroscope_user:metroscope_secure_password@localhost:5432/metroscope
# Sync database URL for Alembic migrations
DATABASE_SYNC_URL=postgresql://metroscope_user:metroscope_secure_password@localhost:5432/metroscope

# --- Backend API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://themetroscope.com","https://www.themetroscope.com","https://api.themetroscope.com"]
ALLOWED_HOSTS=["localhost","127.0.0.1","themetroscope.com","www.themetroscope.com","api.themetroscope.com","backend","testserver","test"]
PROJECT_NAME=MetroScope
API_V1_STR=/api/v1

# --- Security & Cryptography ---
# Generate using `openssl rand -hex 32`
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_for_production
OPERATOR_API_KEY=change_this_to_a_secure_random_operator_api_key_for_internal_apis

# --- Frontend (Next.js) ---
NEXT_PUBLIC_APP_NAME=MetroScope
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
PORT=3000

# --- Worker & Webz.io News Collection ---
WORKER_ENABLED=true
WEBZ_IO_API_KEY=your_webz_io_api_token_here
WEBZ_IO_BASE_URL=https://api.webz.io
WEBZ_IO_ENDPOINT=/newsApiLite
WEBZ_IO_COLLECTION_ENABLED=true
WEBZ_IO_MONTHLY_CREDIT=5.00
WEBZ_IO_COLLECTION_CEILING=4.00
WEBZ_IO_PROTECTED_RESERVE=1.00
WEBZ_IO_ESTIMATED_COST_PER_REQUEST=0.0050
WEBZ_IO_REQUEST_TIMEOUT_SECONDS=15.0
WEBZ_IO_MAX_RETRIES=1
WEBZ_IO_TIMEZONE=Asia/Dhaka
WEBZ_IO_SPORTS_SCHEDULE_HOUR=8
WEBZ_IO_SPORTS_SCHEDULE_MINUTE=0
WEBZ_IO_BUSINESS_SCHEDULE_HOUR=20
WEBZ_IO_BUSINESS_SCHEDULE_MINUTE=0
WEBZ_IO_TARGET_ARTICLES_PER_JOB=10

# --- Phase 5: Automated Social Publishing ---
SITE_URL=https://metroscope.news
SOCIAL_PUBLISHING_ENABLED=false
SOCIAL_DRY_RUN=true
SOCIAL_PUBLISHING_INTERVAL_MINUTES=30
SOCIAL_MAX_POSTS_PER_RUN=2
SOCIAL_MIN_QUALITY_SCORE=70.0
STALE_PUBLISHING_TIMEOUT_MINUTES=60

# Facebook Page (Meta Graph API)
FACEBOOK_ENABLED=false
FACEBOOK_PAGE_ID=your_facebook_page_id_here
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here
FACEBOOK_GRAPH_API_VERSION=v27.0
FACEBOOK_DEFAULT_POST_TYPE=photo
FACEBOOK_POST_CAPTION_ENABLED=true
FACEBOOK_FOLLOWUP_COMMENT_ENABLED=true
FACEBOOK_AUTO_PUBLISH=false
FACEBOOK_MAX_POSTS_PER_DAY=48

# X (Twitter API v2)
X_ENABLED=false
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_ACCESS_TOKEN=your_x_access_token_here
X_ACCESS_TOKEN_SECRET=your_x_access_token_secret_here
X_BEARER_TOKEN=your_x_bearer_token_here
X_MAX_POSTS_PER_DAY=15 # Conservative limit respecting X Free tier (17/24h)

# --- Phase 6: Email Subscription & Newsletter Delivery ---
EMAIL_DRY_RUN=true
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=newsletter@metroscope.news
SMTP_FROM_NAME="MetroScope News"
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15.0
NEWSLETTER_SCHEDULE_HOUR=6
NEWSLETTER_SCHEDULE_MINUTE=0
NEWSLETTER_MIN_QUALITY_SCORE=70.0
NEWSLETTER_MAX_ARTICLES=5
SUBSCRIPTION_RATE_LIMIT_PER_HOUR=5
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# --- Phase 7: Photo Card & ScreenshotOne Dual-Key Image Rendering ---
SCREENSHOTONE_ACCESS_KEY_1=your_screenshotone_key_1_here
SCREENSHOTONE_ACCESS_KEY_2=your_screenshotone_key_2_here
SCREENSHOTONE_ACCESS_KEY=
SCREENSHOTONE_SECRET_KEY=
SCREENSHOTONE_BASE_URL=https://api.screenshotone.com
SCREENSHOTONE_TIMEOUT_SECONDS=30.0
SCREENSHOTONE_IMAGE_FORMAT=jpeg
SCREENSHOTONE_IMAGE_QUALITY=90

